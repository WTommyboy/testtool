{
  "name": "uat-tool",
  "version": "1.0.0",
  "description": "UAT Test Tool MVP",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "uat",
    "playwright",
    "express",
    "sqlite"
  ],
  "author": "tommy",
  "license": "ISC",
