{
  "name": "uat-tool",
  "version": "1.1.8",
  "description": "UAT Test Tool MVP",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "check:package-consistency": "tsx scripts/check-test-package-consistency.ts",
    "check:result-evidence": "tsx scripts/check-result-evidence-gate.ts",
    "verify:agent-roundtrip": "npm run build && tsx scripts/verify-agent-roundtrip.ts",
    "verify:helper-hints": "tsx scripts/verify-helper-hints-fixture.ts",
    "verify:helper-field-aliases": "tsx scripts/verify-helper-field-aliases.ts",
    "verify:date-ui-evidence": "tsx scripts/verify-date-ui-evidence.ts",
    "verify:date-ui-dom-smoke": "tsx scripts/verify-date-ui-dom-smoke.ts",
    "verify:capability-gate": "tsx scripts/verify-capability-gate.ts",
    "verify:case-advance-policy": "tsx scripts/verify-case-advance-policy.ts",
    "verify:package-consistency": "tsx scripts/verify-package-consistency-fixture.ts",
    "verify:result-evidence-gate": "tsx scripts/verify-result-evidence-gate.ts",
    "verify:agent-resume": "tsx scripts/verify-agent-resume.ts",
    "verify:agent-connection-resilience": "tsx scripts/verify-agent-connection-resilience.ts",
    "verify:agent-result-contract": "tsx scripts/verify-agent-result-contract.ts",
    "verify:fail-bug-fallback": "tsx scripts/verify-fail-bug-fallback.ts",
    "verify:final-aggregate-result": "tsx scripts/verify-final-aggregate-result.ts",
    "verify:helper-report-gate": "tsx scripts/verify-helper-report-gate.ts",
    "verify:source-prefilled-results": "tsx scripts/verify-source-prefilled-results.ts",
    "verify:all": "npm run typecheck && npm run build --prefix agent && npm run build --prefix web && npm run verify:date-ui-evidence && npm run verify:date-ui-dom-smoke && npm run verify:helper-report-gate && npm run verify:capability-gate && npm run verify:case-advance-policy && npm run verify:tool-bridge && npm run verify:agent-connection-resilience && npm run verify:agent-roundtrip",
    "verify:tool-bridge": "tsx scripts/verify-tool-bridge.ts",
    "postinstall": "playwright install chromium"
  },
  "keywords": [
    "uat",
    "playwright",
    "express",
    "sqlite"
  ],
  "author": "tommy",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "jszip": "^3.10.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "playwright": "^1.59.1",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.4.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.6.0",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
