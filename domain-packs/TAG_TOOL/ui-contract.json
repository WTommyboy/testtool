{
  "schemaVersion": "domain-ui-contract-v0.1",
  "domain": "TAG_TOOL",
  "status": "draft_contract_live_augmented_2026-06-23",
  "purpose": "Reviewed page, component, action, evidence, and safety boundaries for Galaxy Next player tag tool UAT.",
  "pages": [
    {
      "id": "tagPlayerList",
      "routePatterns": [
        "/bi-dev/:locale/tag/player?gameId=:gameId",
        "/bi-rc/:locale/tag/player?gameId=:gameId"
      ],
      "components": [
        "tagList.toolbar",
        "tagList.table",
        "tagList.rowActions",
        "dangerousAction.confirmModal"
      ]
    },
    {
      "id": "tagCreate",
      "routePatterns": [
        "/bi-dev/:locale/tag/player/new?gameId=:gameId",
        "/bi-rc/:locale/tag/player/new?gameId=:gameId"
      ],
      "components": [
        "tagForm.basicFields",
        "conditionTag.valueEditor",
        "manualTag.uploadPanel",
        "dateRange.panel",
        "toast.message"
      ]
    },
    {
      "id": "conditionTagSettingsReadonly",
      "routePatterns": [
        "/bi-dev/:locale/tag/player/:tagId/settings?gameId=:gameId",
        "/bi-rc/:locale/tag/player/:tagId/settings?gameId=:gameId"
      ],
      "components": [
        "conditionTag.settingsReadonly"
      ]
    },
    {
      "id": "manualTagEdit",
      "routePatterns": [
        "/bi-dev/:locale/tag/player/:tagId/edit?gameId=:gameId",
        "/bi-rc/:locale/tag/player/:tagId/edit?gameId=:gameId"
      ],
      "components": [
        "manualTag.editForm",
        "toast.message"
      ]
    },
    {
      "id": "tagInfo",
      "routePatterns": [
        "/bi-dev/:locale/tag/player/:tagId?gameId=:gameId",
        "/bi-rc/:locale/tag/player/:tagId?gameId=:gameId"
      ],
      "components": [
        "tagInfo.basicSettings",
        "tagInfo.latestValueSummary",
        "tagInfo.valueFilter",
        "manualTag.memberTable"
      ]
    },
    {
      "id": "tagVariableSettings",
      "routePatterns": [
        "/bi-dev/:locale/tag/settings?gameId=:gameId",
        "/bi-rc/:locale/tag/settings?gameId=:gameId"
      ],
      "components": [
        "tagVariables.form",
        "tagVariables.history",
        "toast.message"
      ]
    }
  ],
  "components": [
    {
      "id": "tagList.toolbar",
      "type": "toolbar",
      "locatorStrategies": [
        "page title 玩家標籤管理 with adjacent 刪除 and 新增 buttons",
        "breadcrumb containing 標籤 > 玩家標籤管理"
      ]
    },
    {
      "id": "tagList.table",
      "type": "table",
      "locatorStrategies": [
        "table with headers 標籤名稱, 標籤類型, 條件類別, 篩選類型, 排程狀態, 資料最後更新時間, 備註, 操作",
        "empty state text 尚無標籤資料 when no rows exist",
        "2026-06-23 dev capture showed populated state 共 28 筆資料"
      ]
    },
    {
      "id": "tagList.rowActions",
      "type": "menu",
      "locatorStrategies": [
        "row action trigger shown as ⋯ or more button in each tag row",
        "trigger accessible label 更多操作",
        "condition menu items 查看設置, 標籤資訊, 終止, 刪除, 複製",
        "manual menu items 編輯, 標籤資訊, 刪除, 複製"
      ]
    },
    {
      "id": "tagForm.basicFields",
      "type": "form",
      "locatorStrategies": [
        "fields 標籤名稱, 標籤類型, 條件類別, 篩選類型, 分析時段",
        "manual tag hides 條件類別, 篩選類型, 分析時段"
      ]
    },
    {
      "id": "conditionTag.valueEditor",
      "type": "dualPaneEditor",
      "locatorStrategies": [
        "section title 子標籤級距",
        "2026-06-23 dev capture button 新增標籤 and inline lower/upper bound editor",
        "lower operators 無, ≥, >, =",
        "upper operators 無, ≤, <"
      ]
    },
    {
      "id": "manualTag.uploadPanel",
      "type": "fileUpload",
      "locatorStrategies": [
        "section title 上傳文件",
        "text mentions csv and file limits",
        "button 選擇檔案",
        "tooltip mentions 標籤值名稱, 銀河帳號ID ( userobjectid ), 操作"
      ]
    },
    {
      "id": "dateRange.panel",
      "type": "popover",
      "locatorStrategies": [
        "panel title 日期範圍",
        "quick options 昨日, 今日, 上週, 本週, 上月, 本月, 過去7天, 最近7天, 過去30天, 最近30天",
        "dynamic day inputs",
        "buttons 取消 and 確定"
      ]
    },
    {
      "id": "conditionTag.settingsReadonly",
      "type": "summary",
      "locatorStrategies": [
        "route /bi-dev/:locale/tag/player/:tagId/settings?gameId=:gameId",
        "page title 查看設置",
        "section 子標籤級距",
        "read-only fields include 標籤名稱, 條件類別, 篩選類型, 分析時段, 排程狀態, 資料最後更新時間, 備註"
      ]
    },
    {
      "id": "tagInfo.basicSettings",
      "type": "summary",
      "locatorStrategies": [
        "route /bi-dev/:locale/tag/player/:tagId?gameId=:gameId",
        "section 標籤基本設置",
        "condition title group 標籤資訊與每日資訊",
        "manual title group 標籤資訊與名單列表"
      ]
    },
    {
      "id": "tagInfo.latestValueSummary",
      "type": "summary",
      "locatorStrategies": [
        "section 最新標籤值資訊",
        "condition metric 總被標籤人數",
        "manual metric 總授權帳號人數",
        "field 數據更新時間"
      ]
    },
    {
      "id": "tagInfo.valueFilter",
      "type": "dropdown",
      "locatorStrategies": [
        "button label pattern 標籤值 (N/N)",
        "dropdown contains 全選 checkbox and one checkbox per tag value"
      ]
    },
    {
      "id": "manualTag.memberTable",
      "type": "table",
      "locatorStrategies": [
        "manual tag info page 標籤資訊與名單列表",
        "headers #, 標籤值, 銀河帳號ID, 被貼標/異動時間(GMT+08:00)",
        "page-size options 20筆/頁, 50筆/頁, 100筆/頁"
      ]
    },
    {
      "id": "manualTag.editForm",
      "type": "form",
      "locatorStrategies": [
        "route /bi-dev/:locale/tag/player/:tagId/edit?gameId=:gameId",
        "page title 編輯標籤",
        "fields 標籤名稱, 備註, 上傳文件",
        "edit-only guidance 於編輯標籤時，僅需上傳異動(新增/更新/刪除)的名單"
      ]
    },
    {
      "id": "dangerousAction.confirmModal",
      "type": "modal",
      "locatorStrategies": [
        "modal title 刪除 標籤 or 終止 標籤",
        "buttons 取消 plus 刪除 or 確定終止"
      ]
    },
    {
      "id": "tagVariables.form",
      "type": "form",
      "locatorStrategies": [
        "page title 標籤變數設定",
        "numeric controls N, Z, Y, X, A, B with stepper controls"
      ]
    },
    {
      "id": "tagVariables.history",
      "type": "table",
      "locatorStrategies": [
        "table headers 設置時間, N, Z, Y, X, A, B, 備註",
        "time format YYYY.MM.DD HH:MM"
      ]
    }
  ],
  "actions": [
    {
      "id": "tagList.observe",
      "contractFile": "action-contracts/tagList.json",
      "capabilities": [
        "tag.list.columns",
        "tag.list.rowActions",
        "tag.list.emptyState"
      ]
    },
    {
      "id": "tag.createCondition",
      "contractFile": "action-contracts/createConditionTag.json",
      "capabilities": [
        "tag.condition.formState",
        "tag.condition.datePanel",
        "tag.condition.valueEditor"
      ]
    },
    {
      "id": "tag.manualUpload",
      "contractFile": "action-contracts/manualUpload.json",
      "capabilities": [
        "tag.manual.addCsv",
        "tag.manual.editCsv",
        "tag.manual.validation"
      ]
    },
    {
      "id": "tag.infoReadOnly",
      "contractFile": "action-contracts/tagInfoReadOnly.json",
      "capabilities": [
        "tag.info.basicSettings",
        "tag.info.latestValueSummary",
        "tag.info.valueFilter",
        "tag.condition.settingsReadonly",
        "tag.manual.memberTable",
        "tag.manual.editFormObserve"
      ]
    },
    {
      "id": "tag.variables",
      "contractFile": "action-contracts/tagVariableSettings.json",
      "capabilities": [
        "tag.variables.defaults",
        "tag.variables.validation",
        "tag.variables.history"
      ]
    },
    {
      "id": "tag.dangerousActions",
      "contractFile": "action-contracts/dangerousActions.json",
      "capabilities": [
        "tag.delete.cancel",
        "tag.terminate.cancel",
        "tag.irreversible.approvalGate"
      ]
    }
  ],
  "evidenceContract": {
    "file": "evidence-schema.json",
    "policy": [
      "Evidence must be current-run and case-scoped.",
      "Screenshots support structured DOM/text evidence but do not replace it.",
      "Tool Bridge response is required before confirming delete, terminate, save variables, or manual edit update/delete."
    ]
  },
  "lintRules": {
    "file": "lint-rules.json",
    "policy": [
      "Testcase helper hints should match declared domain actions and params.",
      "Dangerous actions require authorization metadata and should be split from ordinary smoke unless explicitly scoped."
    ]
  }
}
