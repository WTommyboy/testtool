{
  "schemaVersion": "domain-action-contract-v0.1",
  "domain": "TAG_TOOL",
  "action": "manualUpload",
  "status": "draft_contract_live_augmented_2026-06-23",
  "purpose": "Manual tag add/edit CSV upload setup and validation evidence.",
  "capabilities": [
    "tag.manual.addCsvFormat",
    "tag.manual.editCsvFormat",
    "tag.manual.fileLimit",
    "tag.manual.fileAccept",
    "tag.manual.selectedFileChips",
    "tag.manual.validationToast",
    "tag.manual.submitValidation"
  ],
  "observedLiveGuidance": {
    "source": "discovery/live-inventory-2026-06-23-dev-ui.md",
    "createMode": [
      "請上傳欲設置的標籤值與名單檔案，請參閱 檔案範例檔.csv。僅可上傳 csv 檔",
      "每個檔案限 10,000 筆資料，每次設置至多 5 個檔案。",
      "tooltip columns: 標籤值名稱, 銀河帳號ID ( userobjectid ), 操作",
      "tooltip says create flow operation can only be add"
    ],
    "editMode": [
      "edit page includes the create guidance",
      "edit-only text: 於編輯標籤時，僅需上傳異動(新增/更新/刪除)的名單",
      "tooltip says edit flow can use add, update, delete"
    ]
  },
  "paramsSchema": {
    "type": "object",
    "required": [
      "flow"
    ],
    "properties": {
      "flow": {
        "type": "string",
        "enum": [
          "observeAddGuidance",
          "uploadAddCsv",
          "uploadInvalidCsv",
          "uploadDuplicateConflictCsv",
          "uploadNonexistentAccountCsv",
          "uploadOverLimitCsv",
          "uploadInvalidTypeFile",
          "observeFileAccept",
          "uploadMultipleFiles",
          "removeSelectedFile",
          "submitWithoutFile",
          "observeEditGuidance",
          "uploadEditCsv"
        ]
      },
      "fixturePath": {
        "type": "string"
      },
      "mode": {
        "type": "string",
        "enum": [
          "add",
          "edit"
        ]
      },
      "fixtureKind": {
        "type": "string",
        "enum": [
          "validAddCsv",
          "invalidAddCsv",
          "validEditCsv",
          "duplicateConflictCsv",
          "nonexistentAccountCsv",
          "textFile",
          "overLimitCsv"
        ]
      }
    },
    "additionalProperties": true
  },
  "sharedFlows": {
    "observeAddGuidance": {
      "declarativePlan": [
        {
          "op": "select",
          "target": "tagForm.tagType",
          "value": "人工標籤"
        },
        {
          "op": "read",
          "target": "tagForm.tagType",
          "saveAs": "tagForm.typeVisibility.state"
        },
        {
          "op": "read",
          "target": "manualTag.uploadPanel",
          "saveAs": "manualUpload.file.state"
        }
      ],
      "requiredEvidence": [
        "tagForm.typeVisibility.state",
        "manualUpload.file.state",
        "manualUpload.fileInput.state"
      ]
    },
    "observeFileAccept": {
      "declarativePlan": [
        {
          "op": "select",
          "target": "tagForm.tagType",
          "value": "人工標籤"
        },
        {
          "op": "read",
          "target": "manualTag.fileInput",
          "saveAs": "manualUpload.fileInput.state"
        }
      ],
      "requiredEvidence": [
        "manualUpload.fileInput.state",
        "interactionLog"
      ]
    },
    "observeEditGuidance": {
      "declarativePlan": [
        {
          "op": "findRow",
          "target": "tagList.table",
          "labelFrom": "params.tagName"
        },
        {
          "op": "click",
          "target": "tagList.rowActions"
        },
        {
          "op": "click",
          "target": "tagList.rowActionItem.edit"
        },
        {
          "op": "read",
          "target": "manualTag.editForm",
          "saveAs": "manualTag.editForm.state"
        }
      ],
      "requiredEvidence": [
        "navigation.state",
        "manualTag.editForm.state",
        "interactionLog"
      ]
    },
    "uploadAddCsv": {
      "declarativePlan": [
        {
          "op": "uploadFile",
          "target": "manualTag.uploadPanel",
          "valueFrom": "params.fixturePath"
        },
        {
          "op": "read",
          "target": "manualTag.uploadPanel",
          "saveAs": "manualUpload.file.state"
        }
      ],
      "requiredEvidence": [
        "fixtureRef.state",
        "manualUpload.file.state",
        "interactionLog"
      ]
    },
    "uploadInvalidCsv": {
      "declarativePlan": [
        {
          "op": "uploadFile",
          "target": "manualTag.uploadPanel",
          "valueFrom": "params.fixturePath"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "manualUpload.validation.state"
        }
      ],
      "requiredEvidence": [
        "fixtureRef.state",
        "manualUpload.file.state",
        "manualUpload.validation.state",
        "interactionLog"
      ]
    },
    "uploadDuplicateConflictCsv": {
      "declarativePlan": [
        {
          "op": "uploadFile",
          "target": "manualTag.uploadPanel",
          "fixtureKind": "duplicateConflictCsv"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "manualUpload.validation.state"
        }
      ],
      "requiredEvidence": [
        "fixtureRef.state",
        "manualUpload.file.state",
        "manualUpload.validation.state",
        "interactionLog"
      ]
    },
    "uploadNonexistentAccountCsv": {
      "declarativePlan": [
        {
          "op": "uploadFile",
          "target": "manualTag.uploadPanel",
          "fixtureKind": "nonexistentAccountCsv"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "manualUpload.validation.state"
        }
      ],
      "requiredEvidence": [
        "fixtureRef.state",
        "manualUpload.file.state",
        "manualUpload.validation.state",
        "interactionLog"
      ]
    },
    "uploadOverLimitCsv": {
      "declarativePlan": [
        {
          "op": "uploadFile",
          "target": "manualTag.uploadPanel",
          "fixtureKind": "overLimitCsv"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "manualUpload.validation.state"
        }
      ],
      "requiredEvidence": [
        "fixtureRef.state",
        "manualUpload.file.state",
        "manualUpload.validation.state",
        "interactionLog"
      ]
    },
    "uploadInvalidTypeFile": {
      "declarativePlan": [
        {
          "op": "uploadFile",
          "target": "manualTag.uploadPanel",
          "fixtureKind": "textFile"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "manualUpload.validation.state"
        }
      ],
      "requiredEvidence": [
        "fixtureRef.state",
        "manualUpload.fileInput.state",
        "manualUpload.validation.state",
        "interactionLog"
      ]
    },
    "uploadMultipleFiles": {
      "declarativePlan": [
        {
          "op": "uploadFile",
          "target": "manualTag.uploadPanel",
          "valueFrom": "params.fixturePaths"
        },
        {
          "op": "read",
          "target": "manualTag.fileChip",
          "saveAs": "manualUpload.file.state"
        }
      ],
      "requiredEvidence": [
        "fixtureRef.state",
        "manualUpload.file.state",
        "interactionLog"
      ]
    },
    "removeSelectedFile": {
      "declarativePlan": [
        {
          "op": "click",
          "target": "manualTag.fileChip.removeButton"
        },
        {
          "op": "read",
          "target": "manualTag.fileChip",
          "saveAs": "manualUpload.file.state"
        }
      ],
      "requiredEvidence": [
        "manualUpload.file.state",
        "interactionLog"
      ]
    },
    "submitWithoutFile": {
      "declarativePlan": [
        {
          "op": "click",
          "target": "tagForm.submitButton"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "manualUpload.validation.state"
        }
      ],
      "requiredEvidence": [
        "manualUpload.file.state",
        "manualUpload.validation.state",
        "interactionLog"
      ]
    }
  },
  "fixtures": {
    "validAddCsv": "fixtures/smoke/manual-tag-add-valid.csv",
    "invalidAddCsv": "fixtures/smoke/manual-tag-add-invalid-header.csv",
    "validEditCsv": "fixtures/smoke/manual-tag-edit-valid.csv",
    "duplicateConflictCsv": "fixtures/smoke/manual-tag-add-duplicate-conflict.csv",
    "nonexistentAccountCsv": "fixtures/smoke/manual-tag-add-nonexistent-account.csv",
    "textFile": "fixtures/smoke/manual-tag-add-invalid-type.txt",
    "overLimitCsv": "generated at runtime with 10001 data rows"
  },
  "blockerCodes": [
    "MANUAL_UPLOAD_PANEL_MISSING",
    "FILE_CHOOSER_UNAVAILABLE",
    "CSV_VALIDATION_TOAST_MISSING",
    "MANUAL_UPLOAD_FILE_ACCEPT_UNVERIFIED",
    "MANUAL_UPLOAD_FILE_CHIP_STATE_UNVERIFIED"
  ]
}
