{
  "schemaVersion": "domain-action-contract-v0.1",
  "domain": "TAG_TOOL",
  "action": "tagList",
  "status": "draft_contract_live_augmented_2026-06-23",
  "purpose": "Shared player tag list observations and row action menu checks.",
  "capabilities": [
    "tag.list.columns",
    "tag.list.emptyState",
    "tag.list.pagination",
    "tag.list.rowNavigation",
    "tag.list.rowActionsByTypeAndSchedule",
    "tag.list.rowActionNavigation",
    "tag.list.deleteCancel"
  ],
  "observedLiveState": {
    "source": "discovery/live-inventory-2026-06-23-dev-ui.md",
    "listPopulation": "2026-06-23 dev capture showed 共 28 筆資料 across pages 1 and 2.",
    "headers": [
      "標籤名稱",
      "標籤類型",
      "條件類別",
      "篩選類型",
      "排程狀態",
      "資料最後更新時間",
      "備註",
      "操作"
    ],
    "rowActionMenuVariants": {
      "條件標籤": [
        "查看設置",
        "標籤資訊",
        "終止",
        "刪除",
        "複製"
      ],
      "人工標籤": [
        "編輯",
        "標籤資訊",
        "刪除",
        "複製"
      ]
    }
  },
  "paramsSchema": {
    "type": "object",
    "required": [
      "flow"
    ],
    "properties": {
      "flow": {
        "type": "string",
        "enum": [
          "observeColumns",
          "observeEmptyState",
          "observePagination",
          "openRowActions",
          "clickTagName",
          "clickRowActionAndVerifyRoute",
          "openDeleteAndCancel"
        ]
      },
      "tagName": {
        "type": "string"
      },
      "tagType": {
        "type": "string",
        "enum": [
          "條件標籤",
          "人工標籤"
        ]
      },
      "scheduleStatus": {
        "type": "string",
        "enum": [
          "進行中",
          "已結束",
          "-",
          "—"
        ]
      },
      "filterType": {
        "type": "string"
      },
      "expectedRoutePattern": {
        "type": "string"
      },
      "expectedMenuItems": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "forbiddenMenuItems": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": true
  },
  "sharedFlows": {
    "observeColumns": {
      "declarativePlan": [
        {
          "op": "ensurePage",
          "target": "tagPlayerList"
        },
        {
          "op": "read",
          "target": "tagList.table",
          "saveAs": "tagList.table.state"
        }
      ],
      "requiredEvidence": [
        "navigation.state",
        "tagList.table.state"
      ]
    },
    "observeEmptyState": {
      "declarativePlan": [
        {
          "op": "ensurePage",
          "target": "tagPlayerList"
        },
        {
          "op": "read",
          "target": "tagList.table",
          "saveAs": "tagList.table.state"
        }
      ],
      "requiredEvidence": [
        "navigation.state",
        "tagList.table.state",
        "fixtureRef.state"
      ]
    },
    "observePagination": {
      "declarativePlan": [
        {
          "op": "ensurePage",
          "target": "tagPlayerList"
        },
        {
          "op": "read",
          "target": "tagList.pagination",
          "saveAs": "tagList.pagination.state"
        }
      ],
      "requiredEvidence": [
        "navigation.state",
        "tagList.table.state",
        "tagList.pagination.state"
      ]
    },
    "openRowActions": {
      "declarativePlan": [
        {
          "op": "findRow",
          "target": "tagList.table",
          "labelFrom": "params.tagName",
          "criteriaFrom": [
            "params.tagType",
            "params.scheduleStatus",
            "params.filterType"
          ]
        },
        {
          "op": "click",
          "target": "tagList.rowActions"
        },
        {
          "op": "read",
          "target": "tagList.rowActions",
          "saveAs": "tagList.rowActionMenu.state"
        }
      ],
      "requiredEvidence": [
        "tagList.row.state",
        "tagList.rowActionMenu.state",
        "interactionLog"
      ]
    },
    "clickTagName": {
      "declarativePlan": [
        {
          "op": "findRow",
          "target": "tagList.table",
          "labelFrom": "params.tagName",
          "criteriaFrom": [
            "params.tagType",
            "params.filterType"
          ]
        },
        {
          "op": "click",
          "target": "tagList.rowNameLink"
        },
        {
          "op": "read",
          "target": "navigation",
          "saveAs": "navigation.state"
        }
      ],
      "requiredEvidence": [
        "tagList.row.state",
        "tagList.rowLink.state",
        "navigation.state",
        "interactionLog"
      ]
    },
    "clickRowActionAndVerifyRoute": {
      "declarativePlan": [
        {
          "op": "runFlow",
          "flow": "openRowActions"
        },
        {
          "op": "click",
          "targetFrom": "params.rowActionItem"
        },
        {
          "op": "read",
          "target": "navigation",
          "saveAs": "navigation.state"
        }
      ],
      "requiredEvidence": [
        "tagList.row.state",
        "tagList.rowActionMenu.state",
        "navigation.state",
        "interactionLog"
      ]
    },
    "openDeleteAndCancel": {
      "declarativePlan": [
        {
          "op": "openModal",
          "target": "dangerousAction.confirmModal",
          "source": "delete action"
        },
        {
          "op": "read",
          "target": "dangerousAction.confirmModal",
          "saveAs": "dangerousModal.state"
        },
        {
          "op": "cancelModal",
          "target": "dangerousAction.confirmModal"
        },
        {
          "op": "assertVisible",
          "target": "tagList.table"
        }
      ],
      "requiredEvidence": [
        "dangerousModal.state",
        "tagList.table.state",
        "interactionLog"
      ]
    }
  },
  "blockerCodes": [
    "TAG_LIST_UNREACHABLE",
    "TAG_ROW_NOT_FOUND",
    "TAG_ROW_ACTION_MENU_MISSING",
    "TAG_ROW_LINK_STATE_UNVERIFIED",
    "TAG_ROW_ACTION_ROUTE_UNVERIFIED",
    "TAG_CONFIRM_MODAL_MISSING"
  ]
}
