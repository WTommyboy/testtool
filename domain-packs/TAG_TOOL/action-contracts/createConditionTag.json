{
  "schemaVersion": "domain-action-contract-v0.1",
  "domain": "TAG_TOOL",
  "action": "createConditionTag",
  "status": "draft_contract_live_augmented_2026-06-27",
  "purpose": "Shared condition-tag creation form, date-panel, and tag-value editor flows.",
  "capabilities": [
    "tag.condition.typeSwitch",
    "tag.condition.categoryOptions",
    "tag.condition.filterTypeOptions",
    "tag.condition.datePanel",
    "tag.condition.valueEditor",
    "tag.condition.boundOperatorOptions",
    "tag.condition.validationToast",
    "tag.condition.saveValidation"
  ],
  "analysisPeriodRules": {
    "source": "PRD v1.3.4",
    "constraints": [
      "Keep static/dynamic analysis periods within the PRD 90-day limit.",
      "Record the exact selected range in detail_json for date-dependent cases.",
      "Use run-package/testcase instructions for environment-specific data availability."
    ]
  },
  "observedLiveDefaults": {
    "source": "discovery/live-inventory-2026-06-27-dev-ui.md",
    "tagType": "條件標籤",
    "conditionCategory": "消費級距 R",
    "filterType": "動態時間區間",
    "analysisPeriod": "過去 7 天",
    "subTagRows": 1,
    "lowerOperator": "≥",
    "upperOperator": "≤",
    "lowerInputValue": "0",
    "upperInputValue": "0",
    "firstRowRemoveButton": "disabled",
    "guidanceText": [
      "標籤值至多 10 個",
      "級距請由大到小排列（第一列為最高區間）",
      "相鄰級距的數值須連貫，不可有空隙或重疊",
      "每個子標籤至少需設定下限或上限其中之一"
    ]
  },
  "paramsSchema": {
    "type": "object",
    "required": [
      "flow"
    ],
    "properties": {
      "flow": {
        "type": "string",
        "enum": [
          "observeInitialCreateState",
          "selectConditionType",
          "observeConditionCategoryOptions",
          "observeFilterTypeOptions",
          "selectFilterTypeAndObserveAnalysisPeriod",
          "openDatePanel",
          "applyDatePreset",
          "verifyDateRangeLimit",
          "addTagValue",
          "addTagValuesToLimit",
          "observeBoundOperatorOptions",
          "submitInvalidTagName",
          "submitInvalidSubTagName",
          "submitInvalidConditionValue",
          "submitLongNoteValidation",
          "submitIncompleteAndObserveToast"
        ]
      },
      "tagName": {
        "type": "string"
      },
      "conditionType": {
        "type": "string",
        "enum": [
          "消費級距 R",
          "累積登入天數",
          "累積未登入天數",
          "累積遊戲時間"
        ]
      },
      "timeType": {
        "type": "string",
        "enum": [
          "動態時間區間",
          "靜態時間區間",
          "依報表區間設置",
          "首次後持續累計"
        ]
      },
      "analysisPeriodLabel": {
        "type": "string"
      },
      "presetLabel": {
        "type": "string"
      },
      "inputValue": {
        "type": "string"
      },
      "noteValue": {
        "type": "string"
      }
    },
    "additionalProperties": true
  },
  "sharedFlows": {
    "observeInitialCreateState": {
      "declarativePlan": [
        {
          "op": "click",
          "target": "tagList.newButton"
        },
        {
          "op": "read",
          "target": "tagForm.tagType",
          "saveAs": "tagForm.typeVisibility.state"
        }
      ],
      "requiredEvidence": [
        "navigation.state",
        "tagForm.typeVisibility.state",
        "interactionLog"
      ]
    },
    "observeConditionCategoryOptions": {
      "declarativePlan": [
        {
          "op": "click",
          "target": "conditionTag.categorySelect"
        },
        {
          "op": "read",
          "target": "conditionTag.categorySelect",
          "saveAs": "conditionTag.categorySelect.state"
        }
      ],
      "requiredEvidence": [
        "conditionTag.categorySelect.state",
        "interactionLog"
      ]
    },
    "observeFilterTypeOptions": {
      "declarativePlan": [
        {
          "op": "click",
          "target": "conditionTag.filterTypeSelect"
        },
        {
          "op": "read",
          "target": "conditionTag.filterTypeSelect",
          "saveAs": "conditionTag.filterTypeSelect.state"
        }
      ],
      "requiredEvidence": [
        "conditionTag.filterTypeSelect.state",
        "interactionLog"
      ]
    },
    "selectFilterTypeAndObserveAnalysisPeriod": {
      "declarativePlan": [
        {
          "op": "select",
          "target": "conditionTag.filterTypeSelect",
          "valueFrom": "params.timeType"
        },
        {
          "op": "read",
          "target": "conditionTag.filterTypeSelect",
          "saveAs": "conditionTag.filterTypeSelect.state"
        },
        {
          "op": "read",
          "target": "dateRange.panel",
          "saveAs": "dateRange.panel.state"
        }
      ],
      "requiredEvidence": [
        "conditionTag.filterTypeSelect.state",
        "dateRange.panel.state",
        "interactionLog"
      ]
    },
    "openDatePanel": {
      "declarativePlan": [
        {
          "op": "select",
          "target": "tagForm.tagType",
          "value": "條件標籤"
        },
        {
          "op": "select",
          "target": "tagForm.timeType",
          "valueFrom": "params.timeType"
        },
        {
          "op": "click",
          "target": "dateRange.panel"
        },
        {
          "op": "read",
          "target": "dateRange.panel",
          "saveAs": "dateRange.panel.state"
        }
      ],
      "requiredEvidence": [
        "tagForm.typeVisibility.state",
        "dateRange.panel.state",
        "interactionLog"
      ]
    },
    "applyDatePreset": {
      "declarativePlan": [
        {
          "op": "runFlow",
          "flow": "openDatePanel"
        },
        {
          "op": "click",
          "target": "dateRange.quickPreset",
          "valueFrom": "params.presetLabel"
        },
        {
          "op": "confirm",
          "target": "dateRange.panel"
        },
        {
          "op": "read",
          "target": "dateRange.panel",
          "saveAs": "dateRange.panel.state"
        }
      ],
      "requiredEvidence": [
        "dateRange.panel.state",
        "interactionLog"
      ]
    },
    "verifyDateRangeLimit": {
      "declarativePlan": [
        {
          "op": "runFlow",
          "flow": "openDatePanel"
        },
        {
          "op": "type",
          "target": "dateRange.customRange",
          "valueFrom": "params.analysisPeriodLabel"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "toast.message.state"
        }
      ],
      "requiredEvidence": [
        "dateRange.panel.state",
        "toast.message.state",
        "interactionLog"
      ]
    },
    "addTagValue": {
      "declarativePlan": [
        {
          "op": "click",
          "target": "conditionTag.valueEditor.addButton"
        },
        {
          "op": "read",
          "target": "conditionTag.valueEditor",
          "saveAs": "conditionTag.valueEditor.state"
        }
      ],
      "requiredEvidence": [
        "conditionTag.valueEditor.state",
        "interactionLog"
      ]
    },
    "addTagValuesToLimit": {
      "declarativePlan": [
        {
          "op": "repeat",
          "target": "conditionTag.valueEditor.addButton",
          "count": 10
        },
        {
          "op": "read",
          "target": "conditionTag.valueEditor",
          "saveAs": "conditionTag.valueEditor.state"
        }
      ],
      "requiredEvidence": [
        "conditionTag.valueEditor.state",
        "interactionLog"
      ]
    },
    "observeBoundOperatorOptions": {
      "declarativePlan": [
        {
          "op": "click",
          "target": "conditionTag.boundOperator"
        },
        {
          "op": "read",
          "target": "conditionTag.boundOperator",
          "saveAs": "conditionTag.boundOperator.state"
        }
      ],
      "requiredEvidence": [
        "conditionTag.valueEditor.state",
        "conditionTag.boundOperator.state",
        "interactionLog"
      ]
    },
    "submitInvalidTagName": {
      "declarativePlan": [
        {
          "op": "type",
          "target": "tagForm.tagName",
          "valueFrom": "params.inputValue"
        },
        {
          "op": "click",
          "target": "tagForm.submitButton"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "tagForm.validation.state"
        }
      ],
      "requiredEvidence": [
        "tagForm.validation.state",
        "interactionLog"
      ]
    },
    "submitInvalidSubTagName": {
      "declarativePlan": [
        {
          "op": "type",
          "target": "conditionTag.subTagName",
          "valueFrom": "params.inputValue"
        },
        {
          "op": "click",
          "target": "tagForm.submitButton"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "tagForm.validation.state"
        }
      ],
      "requiredEvidence": [
        "conditionTag.valueEditor.state",
        "tagForm.validation.state",
        "interactionLog"
      ]
    },
    "submitInvalidConditionValue": {
      "declarativePlan": [
        {
          "op": "type",
          "target": "conditionTag.boundInput",
          "valueFrom": "params.inputValue"
        },
        {
          "op": "click",
          "target": "tagForm.submitButton"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "tagForm.validation.state"
        }
      ],
      "requiredEvidence": [
        "conditionTag.valueEditor.state",
        "tagForm.validation.state",
        "interactionLog"
      ]
    },
    "submitLongNoteValidation": {
      "declarativePlan": [
        {
          "op": "type",
          "target": "tagForm.note",
          "valueFrom": "params.noteValue"
        },
        {
          "op": "read",
          "target": "tagForm.note",
          "saveAs": "tagForm.validation.state"
        }
      ],
      "requiredEvidence": [
        "tagForm.validation.state",
        "interactionLog"
      ]
    },
    "submitIncompleteAndObserveToast": {
      "declarativePlan": [
        {
          "op": "click",
          "target": "tagForm.submitButton"
        },
        {
          "op": "read",
          "target": "toast.message",
          "saveAs": "toast.message.state"
        }
      ],
      "requiredEvidence": [
        "toast.message.state",
        "conditionTag.valueEditor.state",
        "interactionLog"
      ]
    }
  },
  "blockerCodes": [
    "TAG_CREATE_UNREACHABLE",
    "TAG_TYPE_DROPDOWN_MISSING",
    "CONDITION_CATEGORY_OPTIONS_UNVERIFIED",
    "CONDITION_FILTER_TYPE_OPTIONS_UNVERIFIED",
    "DATE_PANEL_UNREACHABLE",
    "CONDITION_VALUE_EDITOR_MISSING",
    "CONDITION_BOUND_OPERATOR_OPTIONS_UNVERIFIED",
    "TAG_FORM_VALIDATION_UNVERIFIED"
  ]
}
