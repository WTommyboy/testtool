{
  "schemaVersion": "domain-action-contract-v0.1",
  "domain": "BI_OFFICIAL_UI_COLLAGE",
  "action": "observeFrontendState",
  "status": "draft_contract",
  "purpose": "Collect structured frontend observation evidence for official collage UI cases without requiring preview execution.",
  "capabilities": [
    "collage.observation.userButton",
    "collage.observation.projectToolbar",
    "collage.observation.reportModeRadio",
    "collage.observation.datePanel",
    "collage.observation.validationMessage",
    "collage.observation.sidebarCompanySharedGroup",
    "collage.observation.projectLimitToast",
    "collage.observation.rowActionTooltip",
    "collage.observation.deleteCancelFlow",
    "collage.observation.projectListPagination",
    "collage.observation.sourceReportPicker",
    "collage.observation.fieldPicker",
    "collage.observation.metricRowControls",
    "collage.observation.dateTimeTypeTab",
    "collage.observation.datePanelCancel",
    "collage.observation.dateRangeLimit",
    "collage.observation.editorDownload",
    "collage.observation.saveReportDisabled",
    "collage.observation.saveModalCancel",
    "collage.observation.copyModalCancel"
  ],
  "paramsSchema": {
    "type": "object",
    "required": [
      "observationType"
    ],
    "properties": {
      "observationType": {
        "type": "string",
        "enum": [
          "userButton",
          "projectToolbar",
          "reportModeRadio",
          "datePanel",
          "validationMessage",
          "sidebarGroup",
          "sidebarCompanySharedGroup",
          "projectLimitToast",
          "rowDownloadTooltip",
          "rowDeleteTooltip",
          "rowActionTooltip",
          "deleteCancelFlow",
          "projectListPagination",
          "sourceReportPicker",
          "fieldPicker",
          "metricRowControls",
          "dateTimeTypeTab",
          "datePanelCancel",
          "dateRangeLimit",
          "downloadToast",
          "editorDownload",
          "saveReportDisabled",
          "saveModalCancel",
          "copyModalCancel"
        ]
      },
      "expectedTextContains": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "expectedValidationMessageId": {
        "type": "string",
        "minLength": 1
      },
      "clickTarget": {
        "type": "string",
        "description": "Visible UI target to click before observing, such as dateRange.trigger or preview.calculate."
      }
    },
    "additionalProperties": false
  },
  "declarativePlan": [
    {
      "op": "browserMcpPreflight",
      "saveAs": "browserMcp.preflight"
    },
    {
      "op": "ensurePage",
      "pageFrom": "caseScope.targetPage"
    },
    {
      "op": "observeBySemanticMap",
      "semanticMapFrom": "params.observationType",
      "saveAsFrom": "semanticMap.evidenceObject"
    }
  ],
  "observationTypes": {
    "userButton": {
      "component": "topbar.userButton",
      "semanticMap": "topbarUserButton",
      "requiredEvidence": [
        "topbar.userButton.state"
      ],
      "successState": {
        "visible": true,
        "visibleTextMatchesExpected": true
      }
    },
    "projectToolbar": {
      "component": "projectToolbar.actionButtons",
      "semanticMap": "projectToolbar",
      "requiredEvidence": [
        "projectToolbar.buttons.state"
      ],
      "successState": {
        "semanticButtonStatesMatch": true
      }
    },
    "reportModeRadio": {
      "component": "reportMode.radioGroup",
      "semanticMap": "reportModeRadio",
      "requiredEvidence": [
        "reportMode.radio.state"
      ],
      "successState": {
        "defaultCollageChecked": true
      }
    },
    "datePanel": {
      "component": "dateRange.panel",
      "semanticMap": "dateRangePanel",
      "requiredEvidence": [
        "dateRange.panel.state"
      ],
      "successState": {
        "openedByVisibleUi": true,
        "requiredTextsVisible": true,
        "previewRequestDelta": 0
      }
    },
    "validationMessage": {
      "component": "validation.messageArea",
      "semanticMap": "validationMessages",
      "requiredEvidence": [
        "validation.message.state"
      ],
      "successState": {
        "expectedValidationVisible": true,
        "expectedMessagePattern": "第 {rowIndex} 欄位，欄位未設置完成",
        "multipleIncompleteRowsProduceMultipleMessages": true,
        "previewRequestDelta": 0
      }
    },
    "saveReportDisabled": {
      "component": "editorToolbar.saveButton",
      "semanticMap": "editorToolbarSaveButton",
      "objectIds": [
        "editorToolbar.saveButton"
      ],
      "requiredEvidence": [
        "editorToolbar.saveButton.state"
      ],
      "successState": {
        "visible": true,
        "disabled": true
      }
    },
    "sidebarCompanySharedGroup": {
      "component": "sidebar.companySharedGroup",
      "objectIds": [
        "sidebar.companySharedGroup"
      ],
      "requiredEvidence": [
        "sidebar.companySharedGroup.state"
      ],
      "successState": {
        "expandedAndCollapsedByVisibleUi": true
      }
    },
    "sidebarGroup": {
      "component": "sidebar.companySharedGroup",
      "objectIds": [
        "sidebar.companySharedGroup"
      ],
      "requiredEvidence": [
        "sidebar.companySharedGroup.state"
      ],
      "successState": {
        "expandedAndCollapsedByVisibleUi": true
      }
    },
    "projectCreateModal": {
      "component": "projectCreateModal.panel",
      "objectIds": [
        "sidebar.collageProjectCreateButton",
        "projectCreateModal.panel",
        "projectCreateModal.nameInput",
        "projectCreateModal.cancelButton"
      ],
      "requiredEvidence": [
        "projectCreateModal.flow.state",
        "projectCreateModal.state",
        "interactionLog",
        "screenshot"
      ],
      "successState": {
        "openedByVisibleUi": true,
        "nameInputVerifiedWhenRequired": true,
        "cancelClicked": true,
        "modalClosed": true
      }
    },
    "projectLimitToast": {
      "component": "sidebar.collageProjectCreateButton",
      "objectIds": [
        "sidebar.collageProjectCreateButton",
        "projectLimit.toast"
      ],
      "requiredEvidence": [
        "projectLimit.toast.state"
      ],
      "successState": {
        "limitToastVisible": true
      }
    },
    "rowActionTooltip": {
      "component": "projectList.rowDeleteAction",
      "objectIds": [
        "projectList.rowDeleteAction",
        "projectList.rowDeleteTooltip"
      ],
      "requiredEvidence": [
        "projectList.rowActionTooltip.state"
      ],
      "successState": {
        "tooltipLifecycleCaptured": true
      }
    },
    "rowDownloadTooltip": {
      "component": "projectList.rowDownloadAction",
      "objectIds": [
        "projectList.rowDownloadAction",
        "projectList.rowDownloadTooltip"
      ],
      "requiredEvidence": [
        "projectList.rowActionTooltip.state"
      ],
      "successState": {
        "tooltipLifecycleCaptured": true
      }
    },
    "rowDeleteTooltip": {
      "component": "projectList.rowDeleteAction",
      "objectIds": [
        "projectList.rowDeleteAction",
        "projectList.rowDeleteTooltip"
      ],
      "requiredEvidence": [
        "projectList.rowActionTooltip.state"
      ],
      "successState": {
        "tooltipLifecycleCaptured": true
      }
    },
    "deleteCancelFlow": {
      "component": "projectList.rowDeleteAction",
      "objectIds": [
        "projectList.reportRow",
        "projectList.rowDeleteAction",
        "deleteConfirmModal.panel",
        "deleteConfirmModal.cancelButton"
      ],
      "requiredEvidence": [
        "projectList.deleteCancelFlow.state",
        "deleteConfirmModal.state",
        "projectList.reportRow.state",
        "interactionLog",
        "screenshot"
      ],
      "successState": {
        "deleteClickedByVisibleUi": true,
        "confirmModalVisible": true,
        "cancelClicked": true,
        "modalClosed": true,
        "rowStillVisible": true
      }
    },
    "projectListPagination": {
      "component": "projectList.pagination",
      "objectIds": [
        "projectList.pagination.pageSize",
        "projectList.pagination.nextPage",
        "projectList.pagination.totalRecordText"
      ],
      "requiredEvidence": [
        "projectList.pagination.state",
        "interactionLog",
        "screenshot"
      ],
      "successState": {
        "totalRecordTextVisible": true,
        "pageSizeChanged": true,
        "nextPageClicked": true
      }
    },
    "sourceReportPicker": {
      "component": "metricRows.sourceReportControl",
      "objectIds": [
        "metricRows.sourceReportControl",
        "sourceReportPicker.searchInput",
        "sourceReportPicker.option.dailyReport"
      ],
      "requiredEvidence": [
        "sourceReportPicker.state"
      ],
      "successState": {
        "openedSearchedSelectedByVisibleUi": true
      }
    },
    "fieldPicker": {
      "component": "metricRows.fieldControl",
      "objectIds": [
        "metricRows.sourceReportControl",
        "sourceReportPicker.option.dailyReport",
        "metricRows.fieldControl",
        "fieldPicker.option.newAccounts"
      ],
      "requiredEvidence": [
        "fieldPicker.state",
        "fieldPicker.signature",
        "fieldControl.after"
      ],
      "successState": {
        "sourceSelectedByVisibleUi": true,
        "fieldPickerOpenedByVisibleUi": true,
        "fieldSelectedByVisibleUi": true,
        "fieldControlUpdated": true
      }
    },
    "metricRowControls": {
      "component": "metricRows.controls",
      "objectIds": [
        "metricRows.addRowButton",
        "metricRows.duplicateRowButton",
        "metricRows.deleteRowButton"
      ],
      "requiredEvidence": [
        "metricRows.state",
        "dom.state",
        "screenshot"
      ],
      "successState": {
        "firstRowDeleteDisabled": true,
        "duplicateControlEnabled": true
      }
    },
    "dateTimeTypeTab": {
      "component": "dateRange.panel",
      "objectIds": [
        "dateRange.timeTypeTab.dynamic",
        "dateRange.timeTypeTab.static"
      ],
      "requiredEvidence": [
        "dateRange.timeTypeTab.state"
      ],
      "successState": {
        "targetTabStateCaptured": true
      }
    },
    "datePanelCancel": {
      "component": "dateRange.panel",
      "objectIds": [
        "dateRange.panel",
        "dateRange.action.cancel"
      ],
      "requiredEvidence": [
        "dateRange.cancelFlow.state"
      ],
      "successState": {
        "cancelClosedPanelAndPreservedState": true
      }
    },
    "dateRangeLimit": {
      "component": "dateRange.panel",
      "objectIds": [
        "dateRange.panel",
        "dateRange.staticStartInput",
        "dateRange.staticEndInput",
        "dateRange.action.confirm",
        "dateRange.limitValidation"
      ],
      "requiredEvidence": [
        "dateRange.limitValidation.state",
        "interactionLog",
        "screenshot"
      ],
      "successState": {
        "invalid91DayRangeBlocked": true,
        "valid90DayRangeAccepted": true,
        "previewRequestDelta": 0
      }
    },
    "editorDownload": {
      "component": "editorToolbar.downloadButton",
      "objectIds": [
        "editorToolbar.downloadButton",
        "download.toast"
      ],
      "requiredEvidence": [
        "editorToolbar.download.state",
        "download.toast.state"
      ],
      "successState": {
        "downloadStartedAndToastVisible": true
      }
    },
    "downloadToast": {
      "component": "editorToolbar.downloadButton",
      "objectIds": [
        "editorToolbar.downloadButton",
        "download.toast"
      ],
      "requiredEvidence": [
        "editorToolbar.download.state",
        "download.toast.state"
      ],
      "successState": {
        "downloadStartedAndToastVisible": true
      }
    },
    "saveModalCancel": {
      "component": "save.modal",
      "objectIds": [
        "editorToolbar.saveButton",
        "saveModal.reportNameInput",
        "saveModal.projectSelect",
        "saveModal.saveButton",
        "saveModal.cancelButton",
        "projectList.reportRow"
      ],
      "requiredEvidence": [
        "saveModal.cancelFlow.state"
      ],
      "successState": {
        "modalOpenedByVisibleUi": true,
        "nameInputVerified": true,
        "cancelClicked": true,
        "modalClosed": true,
        "noReportCreated": true
      }
    },
    "copyModalCancel": {
      "component": "copy.modal",
      "objectIds": [
        "editorToolbar.copyButton",
        "copyModal.reportNameInput",
        "copyModal.projectSelect",
        "copyModal.hintText",
        "copyModal.cancelButton"
      ],
      "requiredEvidence": [
        "copyModal.cancelFlow.state"
      ],
      "successState": {
        "modalOpenedByVisibleUi": true,
        "defaultNameContainsCopySuffix": true,
        "cancelClicked": true,
        "modalClosed": true
      }
    }
  },
  "locatorPolicy": {
    "readOnlyDomAllowedFor": [
      "text",
      "visible state",
      "disabled state",
      "checked state",
      "aria state",
      "computed style",
      "nearest label",
      "request count delta"
    ],
    "visibleUiRequiredFor": [
      "date panel opening",
      "invalid operation validation trigger"
    ],
    "forbidden": [
      "direct product API setup",
      "internal JavaScript setters",
      "DOM mutation",
      "programmatic click through evaluate"
    ]
  },
  "requiredEvidence": [
    "browserMcp.preflight",
    "one observationTypes.*.requiredEvidence object"
  ],
  "blockerCodes": [
    "TOOL_EXECUTION_UNAVAILABLE_WITHOUT_PREFLIGHT",
    "OBSERVATION_SEMANTIC_MAP_MISSING",
    "EVIDENCE_INSUFFICIENT",
    "BLOCKED_NEEDS_VISUAL_REVIEW"
  ]
}
