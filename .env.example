PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_SLOWMO_MS=300
PLAYWRIGHT_TIMEOUT_MS=30000
PLAYWRIGHT_PROFILE_DIR=./storage/playwright-profile
APPROVAL_TTL_MIN=30
