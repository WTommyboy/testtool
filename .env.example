PLAYWRIGHT_HEALTHCHECK_TIMEOUT_MS=5000
PLAYWRIGHT_INTERACTIVE_LOGIN_WAIT_MS=120000
PLAYWRIGHT_CRASH_DOWN_MS=30000
PLAYWRIGHT_CRASH_CONSECUTIVE_THRESHOLD=3

ENABLE_GOOGLE_SHEETS_SYNC=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
